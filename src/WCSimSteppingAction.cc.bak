    //End JR edit
	
    const G4Event *event = G4EventManager::GetEventManager()->GetConstCurrentEvent();
    if(event->IsAborted() || event->GetEventID() < 0)
      return;
  //DISTORTION must be used ONLY if INNERTUBE or INNERTUBEBIG has been defined in BidoneDetectorConstruction.cc
  
  const G4Track* track       = aStep->GetTrack();

  // ============================================================
  // AllSecondaries: one row per step for the event primary and
  // every non-optical secondary particle. This is passive truth
  // logging only; it does not alter tracking or physics processes.
  // Primary particles are identifiable by parent == 0 and creator == "NONE".
  // ============================================================
  if (track &&
      track->GetDefinition() != G4OpticalPhoton::OpticalPhotonDefinition()) {

    const auto* def = track->GetDefinition();
    const auto* pre = aStep->GetPreStepPoint();
    const auto* post = aStep->GetPostStepPoint();

    AllSecondariesTree_ResetVars();

    alls_evt    = event ? event->GetEventID() : -1;
    alls_trk    = track->GetTrackID();
    alls_parent = track->GetParentID();
    alls_pdg    = def ? def->GetPDGEncoding() : 0;
    alls_step   = track->GetCurrentStepNumber();

    if (pre) {
      const auto pos = pre->GetPosition();
      alls_x_cm = pos.x() / cm;
      alls_y_cm = pos.y() / cm;
      alls_z_cm = pos.z() / cm;
      alls_t_ns = pre->GetGlobalTime() / ns;

      const auto dir = pre->GetMomentumDirection();
      alls_dir_x = dir.x();
      alls_dir_y = dir.y();
      alls_dir_z = dir.z();

      alls_ke_MeV = pre->GetKineticEnergy() / MeV;
      alls_volume = JRNameOfVolume(pre->GetPhysicalVolume());
      alls_material = JRNameOfMaterial(pre);
    }

    if (post) {
      const auto pos = post->GetPosition();
      alls_post_x_cm = pos.x() / cm;
      alls_post_y_cm = pos.y() / cm;
      alls_post_z_cm = pos.z() / cm;
      alls_post_t_ns = post->GetGlobalTime() / ns;

      const auto dir = post->GetMomentumDirection();
      alls_post_dir_x = dir.x();
      alls_post_dir_y = dir.y();
      alls_post_dir_z = dir.z();

      alls_post_ke_MeV = post->GetKineticEnergy() / MeV;
      alls_post_volume = JRNameOfVolume(post->GetPhysicalVolume());
      alls_post_material = JRNameOfMaterial(post);

      const G4VProcess* stepProc = post->GetProcessDefinedStep();
      alls_step_process = stepProc ? std::string(stepProc->GetProcessName()) : std::string("NONE");
    }

    alls_edep_MeV = aStep->GetTotalEnergyDeposit() / MeV;
    alls_step_length_cm = aStep->GetStepLength() / cm;
    alls_track_length_cm = track->GetTrackLength() / cm;
    alls_charge = def ? static_cast<float>(def->GetPDGCharge()) : 0.f;
    alls_particle = def ? std::string(def->GetParticleName()) : std::string("NONE");

    const G4VProcess* creator = track->GetCreatorProcess();
    alls_creator = creator ? std::string(creator->GetProcessName()) : std::string("NONE");

    AllSecondariesTree_Fill();
  }


  //JR EDIT BEGIN

  // ===============================
// JR: Michel photon birth capture
// ===============================
{
  const G4Track* trk0 = aStep->GetTrack();
  if (trk0) {

    // Clear cache once per event
    const int evtID = G4RunManager::GetRunManager()->GetCurrentEvent()->GetEventID();
    if (evtID != g_birth_evt_latch) {
      g_birth_evt_latch = evtID;
      g_michelPhotonBirth.clear();
      //g_michelPhotonFilled.clear();
    }
    
    if (evtID != g_primary_birth_evt_latch) {
  g_primary_birth_evt_latch = evtID;
  g_primaryPhotonBirth.clear();
}

        if (evtID != g_secondary_e_birth_evt_latch) {
      g_secondary_e_birth_evt_latch = evtID;
      g_secondaryElectronPhotonBirth.clear();
    }

    if (evtID != g_all_secondary_birth_evt_latch) {
      g_all_secondary_birth_evt_latch = evtID;
      g_allSecondaryPhotonBirth.clear();
      AllSecondaryPhotonsTree_ResetEvent(evtID);
    }

    // Only look at the Michel e± track (set in TrackingAction)
    if (g_michel_trk >= 0 && trk0->GetTrackID() == g_michel_trk) {
      // ---- DEBUG: confirm SteppingAction is seeing Michel track ----
