         << " michel_trk=" << g_michel_trk
         << " nsec=" << nsec
         << G4endl;
}
*/	
	if (secs) {
          for (auto* sec : *secs) {
            
            // ---- DEBUG: show first few secondaries types/creators ----
static int dbg_sec_show = 0;

/*
