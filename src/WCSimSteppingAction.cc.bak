int WCSimSteppingAction::primaryMuonTrackID = -1;
int WCSimSteppingAction::primaryMuonEventID = -1;

extern int g_michel_trk;   // set in TrackingAction when you identify the Michel e±
extern int g_wcsim_evt;    // your per-event number 

struct MichelPhotonStartInfo {
  int evt = -1;
  int trk = -1;
  int parent = -1;
  int pdg = -1;
  int michel_trk = -1;

  float sx_cm = 0, sy_cm = 0, sz_cm = 0, st_ns = 0;
  float dir_x = 0, dir_y = 0, dir_z = 0;
  float lambda_nm = 0;

  std::string creator = "";
};

struct PrimaryPhotonStartInfo {
  int evt = -1;
  int trk = -1;
  int par = -1;
  int pdg = -1;
  int muAncestorID = -1;

  float edir_x = 0, edir_y = 0, edir_z = 0;
  float ex_cm = 0, ey_cm = 0, ez_cm = 0, et_ns = 0;

  float Estart_MeV = 0;
  float muKE_MeV = 0;
  int   muStep = -1;

  float lambda_nm = 0;
  std::string creator = "";
};

struct SecondaryElectronPhotonStartInfo {
  int evt = -1;
  int trk = -1;
  int parent = -1;
  int pdg = -1;
  int sec_e_trk = -1;

  float sx_cm = 0, sy_cm = 0, sz_cm = 0, st_ns = 0;
  float dir_x = 0, dir_y = 0, dir_z = 0;
  float lambda_nm = 0;

  std::string creator = "";
};

struct AllSecondaryPhotonStartInfo {
  int evt = -1;
  int trk = -1;
  int parent = -1;
  int parent_pdg = 0;
  int parent_parent = -1;
  int parent_step = -1;
  int pdg = 0;

  float parent_ke_MeV = 0.f;
  float sx_cm = 0.f, sy_cm = 0.f, sz_cm = 0.f, st_ns = 0.f;
  float dir_x = 0.f, dir_y = 0.f, dir_z = 0.f;
  float lambda_nm = 0.f;

  int hit_pmt = -1;
  float hit_x_cm = 0.f, hit_y_cm = 0.f, hit_z_cm = 0.f, hit_t_ns = 0.f;
  std::string hit_volume = "";

  std::string creator = "";
  std::string parent_creator = "";
};

static std::string JRNameOfVolume(const G4VPhysicalVolume* pv)
{
  return pv ? std::string(pv->GetName()) : std::string("NONE");
}

static std::string JRNameOfMaterial(const G4StepPoint* point)
{
  const auto* mat = point ? point->GetMaterial() : nullptr;
  return mat ? std::string(mat->GetName()) : std::string("NONE");
}

static bool JRIsLocalPMTVolumeName(const std::string& name)
{
  // Match the older working TTrees: only the actual per-PMT physical
  // volume named "pmt" is a PMT hit.  Do not accept WCMultiPMT /
  // other PMT-like container names here, because their copy numbers are
  // module/slot copy numbers, not local PMT indices 0..18.
  return (name == "pmt");
}

static int JRPMTIDFromStep(const G4Step* step)
{
  const auto* post = step ? step->GetPostStepPoint() : nullptr;
  const auto* touch = post ? post->GetTouchable() : nullptr;
  if (!touch) return -1;

  int pmtCopy = -1;
  int moduleCopy = -1;

  const int depth = touch->GetHistoryDepth();
  for (int d = 0; d <= depth; ++d) {
    const auto* vol = touch->GetVolume(d);
    if (!vol) continue;
    const std::string nm = vol->GetName();

    if (nm == "pmt") {
      pmtCopy = touch->GetCopyNumber(d);
    }
    if (nm == "WCMultiPMT" ||
        nm == "WCMultiPMT_AirGap" ||
        nm == "WCMultiPMT_NoGap") {
      moduleCopy = touch->GetCopyNumber(d);
    }
  }

  // Do not fall back to touch->GetCopyNumber(0).  If the post volume is a
  // module/container rather than the true local "pmt" volume, that fallback
  // is exactly how module copy numbers such as 20--40 can leak into the PMT
  // branch.
  if (pmtCopy < 0) return -1;

  // WCTE mPMTs have local PMT indices 0..18.  If this ever fails, do not
  // write a bogus PMT id; leave it unassigned so the problem is visible.
  if (pmtCopy > 18) return -1;

  // Keep the same full hit_pmt convention used by the older photon TTrees:
  // 100*moduleCopy + localPMTCopy.  The local PMT component is therefore
  // always hit_pmt % 100 and is guaranteed to be 0..18 here.
  return (moduleCopy >= 0) ? (100 * moduleCopy + pmtCopy) : pmtCopy;
}

