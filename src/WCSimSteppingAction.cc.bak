	    if (!sec) continue;
            if (sec->GetDefinition() != G4OpticalPhoton::OpticalPhotonDefinition()) continue;

            const G4VProcess* cp = sec->GetCreatorProcess();
            const G4String creator = cp ? cp->GetProcessName() : "NONE";
            if (creator != "Cerenkov") continue;
	//G4cout << "[DBG-CACHE] key(ptr)=" << sec << " trkID=" << sec->GetTrackID() << G4endl;
            MichelPhotonStartInfo info;
            info.evt       = evtID;
            info.trk       = sec->GetTrackID();
            info.parent    = trk0->GetTrackID();   // parent is the Michel e± track
            info.pdg       = sec->GetDefinition()->GetPDGEncoding();
            info.michel_trk= g_michel_trk;

            const auto pos = sec->GetPosition();
            info.sx_cm = pos.x()/cm;
            info.sy_cm = pos.y()/cm;
            info.sz_cm = pos.z()/cm;
            info.st_ns = sec->GetGlobalTime()/ns;

            const auto dir = sec->GetMomentumDirection();
            info.dir_x = dir.x();
            info.dir_y = dir.y();
            info.dir_z = dir.z();

            const G4double Eph = sec->GetTotalEnergy();
            info.lambda_nm = (h_Planck * c_light / Eph) / nm;

            info.creator = creator;

            // Cache this photon's birth info until it ends / hits a PMT
            g_michelPhotonBirth[sec] = info;
          }
        }
      }
    }
  }
}

// ============================================================
// Secondary-electron photon birth capture
// ============================================================
{
  const G4Track* trk0 = aStep->GetTrack();
  if (trk0) {
    const auto* def0 = trk0->GetDefinition();
    const int pdg0 = def0 ? def0->GetPDGEncoding() : 0;

    // Track only secondary electrons here (PDG = 11, parent > 0).
    if (pdg0 == 11 && trk0->GetParentID() > 0) {
      const auto* secs = aStep->GetSecondaryInCurrentStep();
      if (secs) {
        const int evtID = G4RunManager::GetRunManager()->GetCurrentEvent()->GetEventID();
        for (auto* sec : *secs) {
          if (!sec) continue;
          if (sec->GetDefinition() != G4OpticalPhoton::OpticalPhotonDefinition()) continue;

          const G4VProcess* cp = sec->GetCreatorProcess();
          const G4String creator = cp ? cp->GetProcessName() : "NONE";
          if (creator != "Cerenkov") continue;

          SecondaryElectronPhotonStartInfo info;
          info.evt       = evtID;
          info.trk       = sec->GetTrackID();
          info.parent    = trk0->GetTrackID();
          info.pdg       = sec->GetDefinition()->GetPDGEncoding();
          info.sec_e_trk = trk0->GetTrackID();

          const auto pos = sec->GetPosition();
          info.sx_cm = pos.x() / cm;
          info.sy_cm = pos.y() / cm;
          info.sz_cm = pos.z() / cm;
          info.st_ns = sec->GetGlobalTime() / ns;

          const auto dir = sec->GetMomentumDirection();
          info.dir_x = dir.x();
          info.dir_y = dir.y();
          info.dir_z = dir.z();

          const G4double Eph = sec->GetTotalEnergy();
          info.lambda_nm = (h_Planck * c_light / Eph) / nm;

          info.creator = creator;
          g_secondaryElectronPhotonBirth[sec] = info;
        }
      }
    }
  }
}

// ============================================================
// All-primary-and-secondary photon birth capture
// ============================================================
{
  const G4Track* trk0 = aStep->GetTrack();
  if (trk0) {
    const auto* def0 = trk0->GetDefinition();
    const bool isOpticalParent =
        (def0 == G4OpticalPhoton::OpticalPhotonDefinition());

    // Immediate parent must be a real charged/neutral particle track, not
    // another optical photon. This now intentionally includes the generated
    // event primary as well as all non-optical secondary particles. Primary
    // photons are identifiable downstream by parent_parent == 0 and
    // parent_creator == "NONE".
    if (!isOpticalParent) {
      const auto* secs = aStep->GetSecondaryInCurrentStep();
      if (secs) {
        const int evtID = G4RunManager::GetRunManager()->GetCurrentEvent()->GetEventID();
        const auto* parentPre = aStep->GetPreStepPoint();
        const G4VProcess* parentCreator = trk0->GetCreatorProcess();

        for (auto* sec : *secs) {
          if (!sec) continue;
          if (sec->GetDefinition() != G4OpticalPhoton::OpticalPhotonDefinition()) continue;

          const G4VProcess* cp = sec->GetCreatorProcess();
          const G4String creator = cp ? cp->GetProcessName() : "NONE";
          if (creator != "Cerenkov") continue;

          AllSecondaryPhotonStartInfo info;
          info.evt = evtID;
          info.trk = sec->GetTrackID();
          info.parent = trk0->GetTrackID();
          info.parent_pdg = def0 ? def0->GetPDGEncoding() : 0;
          info.parent_parent = trk0->GetParentID();
          info.parent_step = trk0->GetCurrentStepNumber();
          info.pdg = sec->GetDefinition()->GetPDGEncoding();
          info.parent_ke_MeV = parentPre ? (parentPre->GetKineticEnergy() / MeV)
                                         : (trk0->GetKineticEnergy() / MeV);

          const auto pos = sec->GetPosition();
          info.sx_cm = pos.x() / cm;
          info.sy_cm = pos.y() / cm;
          info.sz_cm = pos.z() / cm;
          info.st_ns = sec->GetGlobalTime() / ns;

          const auto dir = sec->GetMomentumDirection();
          info.dir_x = dir.x();
          info.dir_y = dir.y();
          info.dir_z = dir.z();

          const G4double Eph = sec->GetTotalEnergy();
          info.lambda_nm = (h_Planck * c_light / Eph) / nm;

          info.creator = std::string(creator);
          info.parent_creator = parentCreator
              ? std::string(parentCreator->GetProcessName())
              : std::string("NONE");

          g_allSecondaryPhotonBirth[sec] = info;
        }
      }
    }
  }
}

//JR EDIT END

  // Not used:
  //const G4Event* evt = G4RunManager::GetRunManager()->GetCurrentEvent();
  //G4VPhysicalVolume* volume  = track->GetVolume();
  //G4SDManager* SDman   = G4SDManager::GetSDMpointer();
  //G4HCofThisEvent* HCE = evt->GetHCofThisEvent();

  
  // Debug for photon tracking
  G4StepPoint* thePrePoint = aStep->GetPreStepPoint();
  G4VPhysicalVolume* thePrePV = thePrePoint->GetPhysicalVolume();

  G4StepPoint* thePostPoint = aStep->GetPostStepPoint();
  G4VPhysicalVolume* thePostPV = thePostPoint->GetPhysicalVolume();

  //G4OpBoundaryProcessStatus boundaryStatus=Undefined;
  //static G4ThreadLocal G4OpBoundaryProcess* boundary=NULL;  //doesn't work and needs #include tls.hh from Geant4.9.6 and beyond
  G4OpBoundaryProcess* boundary=NULL;
  
  //find the boundary process only once
  if(!boundary){
    G4ProcessManager* pm
      = aStep->GetTrack()->GetDefinition()->GetProcessManager();
    G4int nprocesses = pm->GetProcessListLength();
    G4ProcessVector* pv = pm->GetProcessList();
    G4int i;
    for( i=0;i<nprocesses;i++){
      if((*pv)[i]->GetProcessName()=="OpBoundary"){
	boundary = (G4OpBoundaryProcess*)(*pv)[i];
	break;
      }
    }
  }

  G4ParticleDefinition *particleType = track->GetDefinition();
  if(particleType == G4OpticalPhoton::OpticalPhotonDefinition() && thePrePV && thePostPV){
    
    //JR EDIT BEGIN
  

  // ============================================================
// JR: Michel photon finalization (PMT hit or photon termination)
// ============================================================
{
  // Only care about photons we cached at creation time
  auto it = g_michelPhotonBirth.find(track);
  if (it != g_michelPhotonBirth.end()){

  const MichelPhotonStartInfo& info = it->second;

  // -------- Detect a PMT "hit" (best-effort from geometry) --------
  int hitPMT = -1;

  // You already established your touchable scheme works:
  // hitPMT = 100*moduleCopy + pmtCopy (or your 10000 scheme).
  // Keep the exact logic you already have working here.
  //
  // IMPORTANT: do NOT return early just because it isn't a PMT.
  // We still want to record non-PMT terminations.

  // Determine if this step looks like entering a PMT *now*
  bool enteredPMT = false;
  if (thePostPV) {
    const std::string postName = thePostPV->GetName();
    enteredPMT = (postName == "pmt");  // you’re using pmt at depth=0
  }

  if (enteredPMT) {
    const auto* post = aStep->GetPostStepPoint();
    const auto* touch = post ? post->GetTouchable() : nullptr;

    if (touch && touch->GetHistoryDepth() >= 2) {
      // From your dump:
      // d=0 pmt copy=pmtCopy
      // d=2 WCMultiPMT copy=moduleCopy
      const int pmtCopy    = touch->GetCopyNumber(0);
      const int moduleCopy = touch->GetCopyNumber(2);

      // Match what you decided earlier. Your prints showed hitPMT like 7810 etc.
      hitPMT = 100 * moduleCopy + pmtCopy;
    }
  }

  // -------- Determine if photon is terminating on THIS step --------
  const bool killedNow =
      (track->GetTrackStatus() == fStopAndKill) ||
      (track->GetTrackStatus() == fStopAndKill);

  // If it neither hit a PMT nor got killed, don’t finalize yet.
  if (hitPMT >= 0 || !killedNow) {

  // -------- Final boundary + end process (best effort) --------
  const std::string endBoundary = thePostPV ? thePostPV->GetName() : "NONE";

  const G4VProcess* endProc = nullptr;
  if (aStep->GetPostStepPoint()) {
    endProc = aStep->GetPostStepPoint()->GetProcessDefinedStep();
  }
  const std::string endProcName = endProc ? endProc->GetProcessName() : "NONE";

  // -------- Fill michel_photons tree from cached birth + end info --------
  mcp_evt        = info.evt;
  mcp_trk        = track->GetTrackID();
  mcp_parent     = track->GetParentID();
  mcp_pdg        = 0; // optical photon
  mcp_michel_trk = info.michel_trk;

  mcp_sx_cm = info.sx_cm;
  mcp_sy_cm = info.sy_cm;
  mcp_sz_cm = info.sz_cm;
  mcp_st_ns = info.st_ns;

  mcp_dir_x = info.dir_x;
  mcp_dir_y = info.dir_y;
  mcp_dir_z = info.dir_z;

  mcp_lambda_nm = info.lambda_nm;

  mcp_hit_pmt     = hitPMT;
  mcp_end_boundary = endBoundary;
  mcp_end_process  = endProcName;
  mcp_creator      = info.creator;

  MichelPhotonsTree_Fill();

  // CRITICAL: erase from birth map so this photon can only be filled once.
  // This also fixes the pointer-reuse problem that was killing your stats.
  g_michelPhotonBirth.erase(it);
}  
}
}


// ============================================================
// Secondary-electron photon finalization (PMT hit or termination)
// ============================================================
{
  auto itse = g_secondaryElectronPhotonBirth.find(track);
  if (itse != g_secondaryElectronPhotonBirth.end()) {

    const SecondaryElectronPhotonStartInfo& info = itse->second;

    int hitPMT = -1;
    bool enteredPMT = false;
    if (thePostPV) {
      const std::string postName = thePostPV->GetName();
      enteredPMT = (postName == "pmt");
    }

    if (enteredPMT) {
      const auto* post = aStep->GetPostStepPoint();
      const auto* touch = post ? post->GetTouchable() : nullptr;
      if (touch && touch->GetHistoryDepth() >= 2) {
        const int pmtCopy    = touch->GetCopyNumber(0);
        const int moduleCopy = touch->GetCopyNumber(2);
        hitPMT = 100 * moduleCopy + pmtCopy;
      }
    }

    const bool killedNow =
        (track->GetTrackStatus() == fStopAndKill) ||
        (track->GetTrackStatus() == fKillTrackAndSecondaries);

    if (hitPMT >= 0 || killedNow) {
      sep_evt       = info.evt;
      sep_trk       = track->GetTrackID();
      sep_parent    = info.parent;
      sep_pdg       = info.pdg;
      sep_sec_e_trk = info.sec_e_trk;

      sep_sx_cm = info.sx_cm;
      sep_sy_cm = info.sy_cm;
      sep_sz_cm = info.sz_cm;
      sep_st_ns = info.st_ns;

      sep_dir_x = info.dir_x;
      sep_dir_y = info.dir_y;
      sep_dir_z = info.dir_z;

      sep_lambda_nm   = info.lambda_nm;
      sep_hit_pmt     = hitPMT;
      sep_end_boundary = thePostPV ? thePostPV->GetName() : "NONE";

      const G4VProcess* endProc =
          aStep->GetPostStepPoint() ? aStep->GetPostStepPoint()->GetProcessDefinedStep() : nullptr;
      sep_end_process = endProc ? endProc->GetProcessName() : "NONE";
      sep_creator     = info.creator;

      SecondaryElectronPhotonsTree_Fill();
      g_secondaryElectronPhotonBirth.erase(itse);
    }
  }
}


// ============================================================
// All-primary-and-secondary photon finalization
// PMT entry, PE flag, termination
// ============================================================
{
  auto itall = g_allSecondaryPhotonBirth.find(track);
  if (itall != g_allSecondaryPhotonBirth.end()) {
    AllSecondaryPhotonStartInfo& info = itall->second;

    if (thePostPV) {
      const std::string postName = thePostPV->GetName();
      const std::string preName = thePrePV ? std::string(thePrePV->GetName()) : std::string("NONE");
      if (info.hit_pmt < 0 && JRIsLocalPMTVolumeName(postName) && preName != "pmt") {
        info.hit_pmt = JRPMTIDFromStep(aStep);
        info.hit_volume = postName;

        const auto* post = aStep->GetPostStepPoint();
        if (post) {
          const auto hitPos = post->GetPosition();
          info.hit_x_cm = hitPos.x() / cm;
          info.hit_y_cm = hitPos.y() / cm;
          info.hit_z_cm = hitPos.z() / cm;
          info.hit_t_ns = post->GetGlobalTime() / ns;
        }
      }
    }

    const bool killedNow =
        (track->GetTrackStatus() == fStopAndKill) ||
        (track->GetTrackStatus() == fKillTrackAndSecondaries);

    if (killedNow) {
      AllSecondaryPhotonsTree_ResetVars();

      asph_evt = info.evt;
      asph_trk = track->GetTrackID();
      asph_parent = info.parent;
      asph_parent_pdg = info.parent_pdg;
      asph_parent_parent = info.parent_parent;
      asph_parent_step = info.parent_step;
      asph_pdg = info.pdg;
      asph_parent_ke_MeV = info.parent_ke_MeV;

      asph_sx_cm = info.sx_cm;
      asph_sy_cm = info.sy_cm;
      asph_sz_cm = info.sz_cm;
      asph_st_ns = info.st_ns;
      asph_dir_x = info.dir_x;
      asph_dir_y = info.dir_y;
      asph_dir_z = info.dir_z;
      asph_lambda_nm = info.lambda_nm;

      asph_hit_pmt = info.hit_pmt;
      asph_hit_x_cm = info.hit_x_cm;
      asph_hit_y_cm = info.hit_y_cm;
      asph_hit_z_cm = info.hit_z_cm;
      asph_hit_t_ns = info.hit_t_ns;
      asph_hit_volume = info.hit_volume;

      int pePMT = -1;
      float peTime = 0.f;
      float peLambda = 0.f;
      if (AllSecondaryPhotonsTree_GetPE(info.evt, track->GetTrackID(), pePMT, peTime, peLambda)) {
        asph_made_pe = 1;
        // Store pe_pmt in the same convention as hit_pmt.  The WCSD PE
        // hook now passes this convention directly; if both are available,
        // prefer the PMT-entry value recorded in this stepping action so the
        // two branches are exactly consistent for PE photons.
        asph_pe_pmt = (info.hit_pmt >= 0) ? info.hit_pmt : pePMT;
        asph_pe_time_ns = peTime;
        asph_pe_lambda_nm = peLambda;
      }

      const auto* post = aStep->GetPostStepPoint();
      if (post) {
        const auto endPos = post->GetPosition();
        asph_end_x_cm = endPos.x() / cm;
        asph_end_y_cm = endPos.y() / cm;
        asph_end_z_cm = endPos.z() / cm;
        asph_end_t_ns = post->GetGlobalTime() / ns;
        asph_end_process = post->GetProcessDefinedStep()
            ? std::string(post->GetProcessDefinedStep()->GetProcessName())
            : std::string("NONE");
      }

      asph_end_status = static_cast<int>(track->GetTrackStatus());
      asph_end_boundary = thePostPV ? std::string(thePostPV->GetName()) : std::string("NONE");
      asph_creator = info.creator;
      asph_parent_creator = info.parent_creator;

      if (asph_hit_pmt < 0 && asph_pe_pmt >= 0) asph_hit_pmt = asph_pe_pmt;

      AllSecondaryPhotonsTree_Fill();
      g_allSecondaryPhotonBirth.erase(itall);
    }
  }
}


// ============================================================
// JR: Primary photon finalization (PMT hit or photon termination)
// ============================================================
{
  auto itp = g_primaryPhotonBirth.find(track);
  if (itp != g_primaryPhotonBirth.end()) {

    const PrimaryPhotonStartInfo& info = itp->second;

    int hitPMT = -1;

    bool enteredPMT = false;
    if (thePostPV) {
      const std::string postName = thePostPV->GetName();
      enteredPMT = (postName == "pmt");
    }

    if (enteredPMT) {
      const auto* post = aStep->GetPostStepPoint();
      const auto* touch = post ? post->GetTouchable() : nullptr;

      if (touch && touch->GetHistoryDepth() >= 2) {
        const int pmtCopy    = touch->GetCopyNumber(0);
        const int moduleCopy = touch->GetCopyNumber(2);

        hitPMT = 100 * moduleCopy + pmtCopy;
      }
    }

    const bool killedNow =
        (track->GetTrackStatus() == fStopAndKill) ||
        (track->GetTrackStatus() == fKillTrackAndSecondaries);

    if (hitPMT >= 0 || killedNow) {

      a_evt = info.evt;
     // a_trk = info.trk;
      a_trk = track->GetTrackID();
      a_par = info.par;
      a_pdg = info.pdg;
      a_muAncestorID = info.muAncestorID;

      a_edir_x = info.edir_x;
      a_edir_y = info.edir_y;
      a_edir_z = info.edir_z;

      a_ex_cm = info.ex_cm;
      a_ey_cm = info.ey_cm;
      a_ez_cm = info.ez_cm;
      a_et_ns = info.et_ns;

      a_Estart_MeV = info.Estart_MeV;
      a_muKE_MeV   = info.muKE_MeV;
      a_muStep     = info.muStep;

      a_lambda_nm = info.lambda_nm;
      a_creator   = info.creator;

      a_hit_pmt = hitPMT;
      a_end_boundary = thePostPV ? thePostPV->GetName() : "NONE";

      const G4VProcess* endProc =
          aStep->GetPostStepPoint() ? aStep->GetPostStepPoint()->GetProcessDefinedStep() : nullptr;
      a_end_process = endProc ? endProc->GetProcessName() : "NONE";

      AllPhotonsTree_Fill();
      g_primaryPhotonBirth.erase(itp);
    }
  }
}

