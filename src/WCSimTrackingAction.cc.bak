    (st == fStopAndKill) ||
    (st == fKillTrackAndSecondaries) ||
    (st == fStopButAlive);  // include if your build uses this at end-of-life

if (!is_terminal_status) return;

// 2) Extra safety: require post-step status is also terminal-ish (optional but helpful)
