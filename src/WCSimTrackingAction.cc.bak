*/


  if ( aTrack->GetDefinition() != G4OpticalPhoton::OpticalPhotonDefinition()
       || G4UniformRand() < percentageOfCherenkovPhotonsToDraw/100. )
    {
      WCSimTrajectory* thisTrajectory = new WCSimTrajectory(aTrack);
      thisTrajectory->SetSavePhotonTrack(true); // mark to save photon track in ROOT
      fpTrackingManager->SetTrajectory(thisTrajectory);
      fpTrackingManager->SetStoreTrajectory(true);
    }
  else if (SAVE_PHOTON_HISTORY)
    {
      // Keep the trajectory but not saving in ROOT
      WCSimTrajectory* thisTrajectory = new WCSimTrajectory(aTrack);
      thisTrajectory->SetSavePhotonTrack(false);
      fpTrackingManager->SetTrajectory(thisTrajectory);
      fpTrackingManager->SetStoreTrajectory(true);
    }
  else 
    fpTrackingManager->SetStoreTrajectory(false);
	
  WCSimPrimaryGeneratorAction *primaryGenerator = (WCSimPrimaryGeneratorAction *) (G4RunManager::GetRunManager()->GetUserPrimaryGeneratorAction());
  if(!primaryGenerator->IsConversionFound()) {
    if(aTrack->GetParentID()==0){
      primaryID = aTrack->GetTrackID();
    }
    else if(aTrack->GetParentID() == primaryID) {
      if (aTrack->GetCreatorProcess()->GetProcessName() == "conv") {
          primaryGenerator->FoundConversion();
      }
      //JR EDIT - UNCOMMENT FOR ORIGINAL CODE BELOW
      //G4EventManager::GetEventManager()->AbortCurrentEvent();
      //G4EventManager::GetEventManager()->GetNonconstCurrentEvent()->SetEventAborted();
    }
  }

  // Kill nucleus generated after TrackID 1
  G4ParticleDefinition* particle = aTrack->GetDefinition();
  G4String name   = particle->GetParticleName();
  G4double fCharge = particle->GetPDGCharge();

  G4Track* tr = (G4Track*) aTrack;
  if ( aTrack->GetTrackID() == 1 ) {
  	// Re-initialize time
  	fTime_birth = 0;
  	// Ask G4 to kill the track when all secondary are done (will exclude other decays)
  	if ( fCharge > 2. )
  		tr->SetTrackStatus(fStopButAlive);
  }

  if ( aTrack->GetTrackID() == 2 ) {
  	// First track of the decay save time
  	fTime_birth = aTrack->GetGlobalTime(); 
  }




//JR EDIT BEGIN
//

    // ============================================================
  // Secondary electron tree: capture start-of-track information
  // ============================================================
  if (aTrack) {
    const auto* def_sec = aTrack->GetDefinition();
    if (def_sec) {
      const int pdg_sec = def_sec->GetPDGEncoding();

      // Track only secondary electrons (PDG = 11, parent > 0).
      // If you later want positrons too, change this to std::abs(pdg_sec) == 11.
      if (pdg_sec == 11 && aTrack->GetParentID() > 0) {
        const G4Event* evt_sec = G4RunManager::GetRunManager()->GetCurrentEvent();
        const int evtID_sec = evt_sec ? evt_sec->GetEventID() : -1;

        se_evt    = evtID_sec;
        se_trk    = aTrack->GetTrackID();
        se_parent = aTrack->GetParentID();
        se_pdg    = pdg_sec;

        const G4ThreeVector vtx_sec = aTrack->GetVertexPosition();
        se_x0_cm = vtx_sec.x() / cm;
        se_y0_cm = vtx_sec.y() / cm;
        se_z0_cm = vtx_sec.z() / cm;
        se_t0_ns = aTrack->GetGlobalTime() / ns;

        se_ke0_MeV = aTrack->GetKineticEnergy() / MeV;

        const G4ThreeVector p0_sec = aTrack->GetMomentum();
        se_px0_MeVc = p0_sec.x() / MeV;
        se_py0_MeVc = p0_sec.y() / MeV;
        se_pz0_MeVc = p0_sec.z() / MeV;
        se_p0_MeVc  = p0_sec.mag() / MeV;

        const G4VProcess* cp_sec = aTrack->GetCreatorProcess();
        se_creator = cp_sec ? cp_sec->GetProcessName() : "NONE";

        se_x1_cm = 0.f;
        se_y1_cm = 0.f;
        se_z1_cm = 0.f;
        se_t1_ns = 0.f;
        se_ke1_MeV = 0.f;
        se_end_process = "";
        se_end_volume  = "";
      }
    }
  }

  // -------- Michel electron identification (Step 0) --------
  

  if (!aTrack) return;

  const G4ParticleDefinition* def = aTrack->GetDefinition();
  if (!def) return;

  const int pdg = def->GetPDGEncoding();

  // Michel electron (from mu- decay) is typically PDG = 11
  if (std::abs(pdg) != 11) return;

  // Primary tracks have no creator process; Michel e- usually has creator "Decay"
  const G4VProcess* cp = aTrack->GetCreatorProcess();
  if (!cp) return;

  const G4String creator = cp->GetProcessName();
  if (creator != "Decay") return;

  // Only take the first Michel-like electron we see in this event
  if (g_michel_trk != -1) return;

  // Record this track as the Michel electron for this event
  g_michel_trk = aTrack->GetTrackID();
  g_michel_electron_started = true;
  // Fill michel_electron_tree (creation info)
  // IMPORTANT: set mce_evt elsewhere (EventAction) before Fill() if you want event numbers.
  mce_trk    = aTrack->GetTrackID();
  mce_parent = aTrack->GetParentID();
  mce_pdg    = pdg;

  const G4ThreeVector vtx = aTrack->GetVertexPosition();
  mce_x0_cm = vtx.x() / cm;
  mce_y0_cm = vtx.y() / cm;
  mce_z0_cm = vtx.z() / cm;

  mce_t0_ns   = aTrack->GetGlobalTime() / ns;
  mce_ke0_MeV = aTrack->GetKineticEnergy() / MeV;

  // Leave end-of-track info unset for now (we can fill later)
  mce_x1_cm = 0.f; mce_y1_cm = 0.f; mce_z1_cm = 0.f;
  mce_t1_ns = 0.f;
  mce_ke1_MeV = 0.f;

  mce_evt = g_wcsim_evt;
  //MichelElectronTree_Fill();
 
  // ---------------------------------------------------------
//JR EDIT END
}

void WCSimTrackingAction::PostUserTrackingAction(const G4Track* aTrack)
{

  //JR EDIT BEGIN
  //
  
// Keep this safe: don't dereference aTrack before checking it
const G4VProcess* creatorProcess = aTrack ? aTrack->GetCreatorProcess() : nullptr;

// -------------------------------------------------------------
// JR: Michel electron end-of-track debug + tree fill
// IMPORTANT: do NOT return out of PostUserTrackingAction here.
// We only do the custom fill conditionally, then fall through to
// the normal WCSim bookkeeping below.
// -------------------------------------------------------------
if (aTrack) {
  const auto* def = aTrack->GetDefinition();
  if (def) {
    const int pdg = def->GetPDGEncoding();

    // Only act on the Michel e± track we latched earlier
    if (g_michel_electron_started &&
        std::abs(pdg) == 11 &&
        aTrack->GetTrackID() == g_michel_trk) {

      // Require that the track is actually terminated
      const auto st = aTrack->GetTrackStatus();
      const bool is_terminal_status =
          (st == fStopAndKill) ||
          (st == fKillTrackAndSecondaries) ||
          (st == fStopButAlive);

      if (is_terminal_status) {

        int postStepStatus = -1;
        if (aTrack->GetStep() && aTrack->GetStep()->GetPostStepPoint()) {
          postStepStatus =
              (int)aTrack->GetStep()->GetPostStepPoint()->GetStepStatus();
        }

        // Fill exactly once per (event, track)
        const int evtID = g_wcsim_evt;
        static int last_evt_filled = -1;
        static int last_trk_filled = -1;

        if (!(evtID == last_evt_filled &&
              aTrack->GetTrackID() == last_trk_filled)) {

          const G4ThreeVector endpos = aTrack->GetPosition();
          const double t_ns   = aTrack->GetGlobalTime() / ns;
          const double ke_MeV = aTrack->GetKineticEnergy() / MeV;

          const double L_cm   = aTrack->GetTrackLength() / cm;
          const int    nSteps = aTrack->GetCurrentStepNumber();

          const G4VProcess* endProc = nullptr;
          if (aTrack->GetStep() && aTrack->GetStep()->GetPostStepPoint()) {
            endProc =
                aTrack->GetStep()->GetPostStepPoint()->GetProcessDefinedStep();
          }
          const G4String endProcName =
              endProc ? endProc->GetProcessName() : "NONE";

          const auto* pv = aTrack->GetVolume();
          const G4String volName = pv ? pv->GetName() : "NONE";
          const auto* mat =
              (pv && pv->GetLogicalVolume())
                  ? pv->GetLogicalVolume()->GetMaterial()
                  : nullptr;
          const G4String matName = mat ? mat->GetName() : "NONE";

          // Debug print
          G4cout << "[MICHEL-END-TRUE] evt=" << evtID
                 << " trk=" << aTrack->GetTrackID()
                 << " pdg=" << pdg
                 << " L(cm)=" << L_cm
                 << " nSteps=" << nSteps
                 << " KEend(MeV)=" << ke_MeV
                 << " status=" << (int)st
                 << " postStepStatus=" << postStepStatus
                 << " endProc=" << endProcName
                 << " vol=" << volName
                 << " mat=" << matName
                 << " t(ns)=" << t_ns
                 << G4endl;

          // Write end branches
          mce_x1_cm   = endpos.x() / cm;
          mce_y1_cm   = endpos.y() / cm;
          mce_z1_cm   = endpos.z() / cm;
          mce_t1_ns   = t_ns;
          mce_ke1_MeV = ke_MeV;

          MichelElectronTree_Fill();

          last_evt_filled = evtID;
          last_trk_filled = aTrack->GetTrackID();
        }
      }
    }
  }
}

  // ============================================================
  // Secondary electron tree: capture end-of-track information
  // ============================================================
  if (aTrack) {
    const auto* def_sec = aTrack->GetDefinition();
    if (def_sec) {
      const int pdg_sec = def_sec->GetPDGEncoding();
      if (pdg_sec == 11 && aTrack->GetParentID() > 0) {
        const G4Event* evt_sec = G4RunManager::GetRunManager()->GetCurrentEvent();
        const int evtID_sec = evt_sec ? evt_sec->GetEventID() : -1;

        const G4ThreeVector endpos = aTrack->GetPosition();
        se_evt    = evtID_sec;
        se_trk    = aTrack->GetTrackID();
        se_parent = aTrack->GetParentID();
        se_pdg    = pdg_sec;

        se_x1_cm   = endpos.x() / cm;
        se_y1_cm   = endpos.y() / cm;
        se_z1_cm   = endpos.z() / cm;
        se_t1_ns   = aTrack->GetGlobalTime() / ns;
        se_ke1_MeV = aTrack->GetKineticEnergy() / MeV;

        const G4VProcess* endProc =
            (aTrack->GetStep() && aTrack->GetStep()->GetPostStepPoint())
                ? aTrack->GetStep()->GetPostStepPoint()->GetProcessDefinedStep()
                : nullptr;
        se_end_process = endProc ? endProc->GetProcessName() : "NONE";

        const auto* pv = aTrack->GetVolume();
        se_end_volume = pv ? pv->GetName() : "NONE";

        SecondaryElectronTree_Fill();
      }
    }
  }


//const G4VProcess* creatorProcess = aTrack->GetCreatorProcess();
  // ----- MICHEL e± true end-of-track dump -----
/*
  if (aTrack) {
    const int pdgi = aTrack->GetDefinition()->GetPDGEncoding();
    const auto* cpi = aTrack->GetCreatorProcess();
    const G4String creatori = cpi ? cpi->GetProcessName() : "NONE";

    // only Michel e± created by mu decay
    if (std::abs(pdgi) == 11 && creatori == "Decay") {

      const int evtIDi = G4RunManager::GetRunManager()->GetCurrentEvent()->GetEventID();

      const auto* stepi = aTrack->GetStep();
      const auto* posti = (stepi ? stepi->GetPostStepPoint() : nullptr);

      const G4VProcess* endP = (posti ? posti->GetProcessDefinedStep() : nullptr);
      const G4String endProc = endP ? endP->GetProcessName() : "NONE";

      const int stepStatus = (posti ? (int)posti->GetStepStatus() : -1);

      const auto* pvi = aTrack->GetVolume();
      const G4String volName = pvi ? pvi->GetName() : "NONE";
      const auto* mati = (pvi && pvi->GetLogicalVolume()) ? pvi->GetLogicalVolume()->GetMaterial() : nullptr;
      const G4String matName = mati ? mati->GetName() : "NONE";

      G4cout << "[MICHEL-END] evt=" << evtIDi
             << " trk=" << aTrack->GetTrackID()
             << " pdg=" << pdgi
             << " KEend(MeV)=" << (aTrack->GetKineticEnergy()/MeV)
             << " trackL(cm)=" << (aTrack->GetTrackLength()/cm)
             << " nSteps=" << aTrack->GetCurrentStepNumber()
             << " status=" << (int)aTrack->GetTrackStatus()
             << " postStepStatus=" << stepStatus
             << " endProc=" << endProc
             << " vol=" << volName
             << " mat=" << matName
             << " t(ns)=" << (aTrack->GetGlobalTime()/ns)
             << G4endl;
    }
 }

  
