if (aTrack->GetStep() && aTrack->GetStep()->GetPostStepPoint()) {
  postStepStatus = (int)aTrack->GetStep()->GetPostStepPoint()->GetStepStatus();
  // In many Geant4 builds, terminal step status is fGeomBoundary(1) or fAtRestDoItProc(2)
