mce_y1_cm   = endpos.y() / cm;
mce_z1_cm   = endpos.z() / cm;
mce_t1_ns   = t_ns;
mce_ke1_MeV = ke_MeV;

// IMPORTANT: do NOT reset g_michel_trk / g_michel_electron_started here.
// Reset them in BeginOfEventAction. That avoids races/odd ordering.
MichelElectronTree_Fill();
